crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Lambda deployment artifacts
lambda.zip
*.zip

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.vscode/
.idea/

# Environment variables
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
